# Copiar este archivo como .env y completar los valores.

# Clave para firmar las sesiones. Usar un texto largo y aleatorio en producción.
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta

# Duración de la sesión (minutos)
TOKEN_EXPIRE_MINUTES=720

# Base de datos (por defecto SQLite en backend/galeria.db).
# Para PostgreSQL: postgresql+psycopg://usuario:clave@host:5432/galeria
# DATABASE_URL=sqlite:///./galeria.db

# Carpeta donde se guardan las imágenes subidas
# UPLOAD_DIR=./uploads

# Tamaño máximo por imagen (MB)
MAX_UPLOAD_MB=15

# Orígenes permitidos (separados por coma). "*" permite cualquiera.
CORS_ORIGINS=*

# Los administradores se definen en admins.json (ver admins.example.json)
